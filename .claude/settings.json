{
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.production)",
      "Read(./.env.backup)",
      "Edit(./.env)",
      "Bash(cat .env:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push origin main:*)",
      "Bash(git reset --hard:*)",
      "Bash(php artisan migrate:fresh:*)",
      "Bash(php artisan migrate:reset:*)",
      "Bash(php artisan migrate:rollback:*)",
      "Bash(php artisan db:wipe:*)",
      "Bash(php artisan db:seed --force:*)",
      "Bash(sudo:*)",
      "Bash(systemctl:*)",
      "Bash(a2ensite:*)",
      "Bash(a2dissite:*)",
      "Bash(a2enmod:*)",
      "Bash(./deploy/deploy.sh:*)",
      "Bash(bash deploy/deploy.sh:*)"
    ]
  }
}
